@echo off
REM Запуск ЛИМС с доступом по локальной сети (для заказчиков).
cd /d "%~dp0"
echo ==========================================================
echo  ЛИМС запущен. Ссылки для браузера:
echo    - на этом ПК:      http://127.0.0.1:8000
for /f "tokens=2 delims=:" %%a in ('ipconfig ^| findstr /i "IPv4"') do echo    - в вашей сети:    http://%%a:8000
echo.
echo  Заказчики в той же сети открывают адрес "в вашей сети".
echo  Логин: zzzz1111*   Пароль: zzzz1111*
echo  Остановить: Ctrl+C
echo ==========================================================
php artisan serve --host=0.0.0.0 --port=8000
